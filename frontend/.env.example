# auto  → ao abrir o app testa a API real, rota por rota (/auth, /manager). O que ainda não existe usa o mock.
# mock  → sempre dados de demonstração.   real → sempre a API real.
VITE_API_MODE=auto
# O Nest escuta na 3000 por padrão (backend/src/main.ts). Ajuste se usar outra PORT.
VITE_API_URL=http://localhost:3000
