generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id_usuario    Int      @id @default(autoincrement())
  nome          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(255)
  cpf           String   @unique @db.VarChar(11)
  telefone      String   @db.VarChar(15)
  senha         String   @db.VarChar(255)
  esta_ativo    Boolean  @default(true)
  criado_em     DateTime @default(now()) @db.Timestamp(6)
  atualizado_em DateTime @default(now()) @updatedAt @db.Timestamp(6)

  psicologo           Psicologo?
  recuperacoes_senha  RecuperacaoSenha[]
}

/// Todo psicólogo é um usuário (RF01): registro profissional (CRP) ligado 1:1 ao Usuario.
model Psicologo {
  id_psicologo Int      @id @default(autoincrement())
  id_usuario   Int      @unique
  crp          String   @unique @db.VarChar(20)
  criado_em    DateTime @default(now()) @db.Timestamp(6)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@map("psicologo")
}

/// Código de recuperação de senha (RF04), de uso único. Guarda só o hash do token.
model RecuperacaoSenha {
  id         Int       @id @default(autoincrement())
  id_usuario Int
  token_hash String    @unique @db.VarChar(64)
  expira_em  DateTime  @db.Timestamp(6)
  usado_em   DateTime? @db.Timestamp(6)
  criado_em  DateTime  @default(now()) @db.Timestamp(6)

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

  @@index([id_usuario, criado_em])
  @@map("recuperacao_senha")
}

