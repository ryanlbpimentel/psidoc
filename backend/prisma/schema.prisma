generator client {
    provider = "prisma-client"
    output   = "./generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    GESTOR
    PSICOLOGO
}

model Usuario {
    id_usuario    Int      @id @default(autoincrement())
    nome          String   @db.VarChar(100)
    email         String   @unique @db.VarChar(255)
    cpf           String   @unique @db.VarChar(11)
    telefone      String   @db.VarChar(15)
    senha         String   @db.VarChar(255)
    esta_ativo    Boolean  @default(true)
    criado_em     DateTime @default(now()) @db.Timestamp(6)
    atualizado_em DateTime @default(now()) @updatedAt @db.Timestamp(6)
    token_version Int      @default(1)
    roles         Role[]   @default([PSICOLOGO])

    psicologo Psicologo?
    tokens    Token[]
}

enum StatusAprovacao {
    PENDENTE
    EM_ANALISE
    APROVADO
}

model Psicologo {
    id_usuario  Int             @id
    crp         String          @unique @db.VarChar(7)
    validado    StatusAprovacao @default(PENDENTE)
    validado_em DateTime?       @db.Timestamp(6)

    usuario        Usuario         @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
    especialidades Especialidade[]
    pacientes      Paciente[]

    @@map("psicologo")
}

enum TokenTipo {
    RECUPERACAO_SENHA
}

model Token {
    id_token   Int       @id @default(autoincrement())
    id_usuario Int
    tipo       TokenTipo @default(RECUPERACAO_SENHA)
    token_hash String    @unique @db.VarChar(64)
    expira_em  DateTime  @db.Timestamp(6)
    usado_em   DateTime? @db.Timestamp(6)
    criado_em  DateTime  @default(now()) @db.Timestamp(6)

    usuario Usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)

    @@index([id_usuario, tipo, criado_em])
    @@map("token")
}

enum Genero {
    MASCULINO
    FEMININO
    OUTRO
    NAO_INFORMADO
}

enum Parentesco {
    PAI
    MAE
    PADRASTO
    MADRASTA
    AVOS
    IRMAOS
    TUTOR_LEGAL
    OUTRO
}

enum Especialidade {
    CLINICA
    NEUROPSICOLOGIA
    OUTRA
}

model Endereco {
    id_endereco Int     @id @default(autoincrement())
    logradouro  String  @db.VarChar(255)
    numero      String  @db.VarChar(20)
    complemento String? @db.VarChar(100)
    bairro      String  @db.VarChar(100)
    municipio   String  @db.VarChar(100)
    estado      String  @db.VarChar(50)
    cep         String  @db.VarChar(9)

    pacientes    Paciente[]
    responsaveis ResponsavelLegal[]

    @@map("endereco")
}

model Paciente {
    id_paciente     Int            @id @default(autoincrement())
    id_psicologo    Int
    id_endereco     Int?
    nome            String         @db.VarChar(100)
    data_nascimento DateTime       @db.Date
    telefone        String?        @db.VarChar(15)
    cpf             String?        @unique @db.VarChar(11)
    status          StatusPaciente @default(ATIVO)
    renda_familiar  Decimal?       @db.Decimal(10, 2)
    genero          Genero?
    observacoes     String?        @db.Text

    psicologo    Psicologo                    @relation(fields: [id_psicologo], references: [id_usuario], onDelete: Cascade)
    endereco     Endereco?                    @relation(fields: [id_endereco], references: [id_endereco])
    responsaveis VinculoPacienteResponsavel[]

    @@map("paciente")
}

enum StatusPaciente {
    ATIVO
    ARQUIVADO
    FINALIZADO
}

model ResponsavelLegal {
    id_responsavel  Int      @id @default(autoincrement())
    id_endereco     Int
    nome            String   @db.VarChar(100)
    data_nascimento DateTime @db.Date
    telefone        String   @db.VarChar(15)
    cpf             String   @unique @db.VarChar(11)
    email           String   @db.VarChar(255)

    endereco  Endereco                     @relation(fields: [id_endereco], references: [id_endereco])
    pacientes VinculoPacienteResponsavel[]

    @@map("responsavel_legal")
}

model VinculoPacienteResponsavel {
    id_vinculo     Int        @id @default(autoincrement())
    id_paciente    Int
    id_responsavel Int
    parentesco     Parentesco

    paciente    Paciente         @relation(fields: [id_paciente], references: [id_paciente], onDelete: Cascade)
    responsavel ResponsavelLegal @relation(fields: [id_responsavel], references: [id_responsavel], onDelete: Cascade)

    @@unique([id_paciente, id_responsavel])
    @@map("vinculo_paciente_responsavel")
}
